# Volta Newsletter App — demo-ready out of the box

# Demo Mailchimp (pretend key — full send flow works without a real API key)
DEMO_MODE=true
MAILCHIMP_API_KEY=DEMO_MAILCHIMP_KEY
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=demo_volta_community
MAILCHIMP_FROM_NAME=Volta
MAILCHIMP_REPLY_TO=hello@voltaeffect.com

# When you get a real Mailchimp key later:
# DEMO_MODE=false
# MAILCHIMP_API_KEY=your-real-key-here
# MAILCHIMP_SERVER_PREFIX=usX
# MAILCHIMP_AUDIENCE_ID=your-audience-id

# OpenAI (optional — without it, research uses local/community heuristics)
OPENAI_API_KEY=

# App
VOLTA_DATA_DIR=./data/local

# Cadence: monthly (default) | biweekly | weekly
# Monthly is intentional — do not change to weekly without an explicit trial.
NEWSLETTER_CADENCE=monthly

# Optional shared secret for POST /ingest/email (leave blank for open local demo)
EMAIL_IN_TOKEN=

# Volta Newsletter App — copy to .env and fill in

# OpenAI (optional — without it, research uses built-in public sources + heuristics)
OPENAI_API_KEY=

# Mailchimp Marketing API (keeps your existing list + send path)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_FROM_NAME=Volta
MAILCHIMP_REPLY_TO=hello@voltaeffect.com

# App
VOLTA_DATA_DIR=./data/local
